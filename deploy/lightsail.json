{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Reviewable single-host Quant Company office. No resource is created by generating this file.",
  "Parameters": {
    "AvailabilityZone": {
      "Type": "String",
      "Description": "An available zone in the selected region, for example ap-northeast-2a."
    },
    "BlueprintId": {
      "Type": "String",
      "Default": "ubuntu_24_04",
      "Description": "Verify with lightsail get-blueprints before applying."
    },
    "BundleId": {
      "Type": "String",
      "Default": "medium_3_0",
      "Description": "Starting target: Linux 4 GB. Verify current regional bundle details before applying."
    },
    "KeyPairName": {
      "Type": "String",
      "Description": "Existing Lightsail SSH key pair name. No private key is embedded."
    },
    "SshCidr": {
      "Type": "String",
      "AllowedPattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$",
      "Description": "Operator public IPv4 /32; never open SSH to the entire internet."
    },
    "BackupBucketName": {
      "Type": "String",
      "AllowedPattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$",
      "Description": "Globally unique private bucket name."
    }
  },
  "Resources": {
    "CompanyHost": {
      "Type": "AWS::Lightsail::Instance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "InstanceName": {
          "Fn::Sub": "${AWS::StackName}-host"
        },
        "AvailabilityZone": {
          "Ref": "AvailabilityZone"
        },
        "BlueprintId": {
          "Ref": "BlueprintId"
        },
        "BundleId": {
          "Ref": "BundleId"
        },
        "KeyPairName": {
          "Ref": "KeyPairName"
        },
        "Networking": {
          "Ports": [
            {
              "Protocol": "tcp",
              "FromPort": 22,
              "ToPort": 22,
              "Cidrs": [
                {
                  "Ref": "SshCidr"
                }
              ]
            },
            {
              "Protocol": "tcp",
              "FromPort": 80,
              "ToPort": 80,
              "Cidrs": [
                "0.0.0.0/0"
              ]
            },
            {
              "Protocol": "tcp",
              "FromPort": 443,
              "ToPort": 443,
              "Cidrs": [
                "0.0.0.0/0"
              ]
            }
          ]
        },
        "Tags": [
          {
            "Key": "Application",
            "Value": "quant-company"
          },
          {
            "Key": "Purpose",
            "Value": "personal-research-office"
          }
        ]
      }
    },
    "CompanyAddress": {
      "Type": "AWS::Lightsail::StaticIp",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "StaticIpName": {
          "Fn::Sub": "${AWS::StackName}-ip"
        },
        "AttachedTo": {
          "Fn::Sub": "${AWS::StackName}-host"
        }
      },
      "DependsOn": "CompanyHost"
    },
    "BackupBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Ref": "BackupBucketName"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "CompanyBackupRetention",
              "Status": "Enabled",
              "Prefix": "company/",
              "ExpirationInDays": 30,
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              },
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 1
              }
            }
          ]
        }
      }
    },
    "BackupBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "BackupBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "DenyPlainHttp",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "BackupBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${BackupBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "PublicIp": {
      "Value": {
        "Fn::GetAtt": [
          "CompanyAddress",
          "IpAddress"
        ]
      }
    },
    "InstanceName": {
      "Value": {
        "Fn::Sub": "${AWS::StackName}-host"
      }
    },
    "BackupUri": {
      "Value": {
        "Fn::Sub": "s3://${BackupBucket}/company/"
      }
    },
    "RetentionNotice": {
      "Value": "Host, static IP and backup bucket are retained on stack deletion. Review and remove retained resources explicitly to end billing."
    }
  }
}
