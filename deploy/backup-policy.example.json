{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackupPrefix",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "company/*",
            "company/"
          ]
        }
      }
    },
    {
      "Sid": "WriteReadCompanyBackups",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_BUCKET/company/*"
      ]
    }
  ]
}
