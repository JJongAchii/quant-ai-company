[Unit]
Description=Continuous Analyst delivery and quality observations

[Timer]
OnCalendar=*-*-* 22:58:00 UTC
OnCalendar=*-*-* 08:58:00 UTC
# Follow delayed Korean closes through the documented 17:00 close case.
OnCalendar=*-*-* 09:58:00 UTC
AccuracySec=10s
RandomizedDelaySec=0
Persistent=true
Unit=quant-company-analyst-monitor.service

[Install]
WantedBy=timers.target
