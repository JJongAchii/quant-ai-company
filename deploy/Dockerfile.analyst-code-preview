# Only for a verified byte-identical project/lock/qdata/entrypoint base.
# Inherit its locked packages and native binaries; replace company source only.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG RELEASE_COMMIT
ARG SOURCE_DIR=src
ARG SOURCE_DEST=/opt/company/src
USER root
WORKDIR /opt/company
COPY ${SOURCE_DIR} ${SOURCE_DEST}
USER 10001:10001
ENV COMPANY_CODE_COMMIT=$RELEASE_COMMIT PYTHONPATH=${SOURCE_DEST}
LABEL org.opencontainers.image.revision=$RELEASE_COMMIT
