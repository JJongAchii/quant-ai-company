[Unit]
Description=Consistent Quant Company database and receipt backup to S3
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/quant-company/current
Environment=AWS_DEFAULT_REGION=ap-northeast-2
EnvironmentFile=/var/lib/quant-company/config/backup.env
ExecStart=/usr/bin/python3 /opt/quant-company/current/deploy/state_backup.py backup --env-file /var/lib/quant-company/config/runtime.env --apply
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
