# Non-secret configuration only. Secret values live in STATE_DIR/secrets.
# Copy to deploy/.env on the host, then configure before starting services.
STATE_DIR=/var/lib/quant-company
RELEASE_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_COMMIT
# Optional https profile only. Socket Mode needs no domain or public HTTP endpoint.
# COMPANY_DOMAIN=office.example.com
# ACME_EMAIL=owner@example.com
DATABASE_NAME=quant_company
SLACK_TEAM_ID=CONFIGURE
SLACK_ALLOWED_USERS=["U_REPLACE"]
SLACK_ALLOWED_CHANNELS=["C_REPLACE"]
TEMPORAL_ADDRESS=configure.tmprl.cloud:7233
TEMPORAL_NAMESPACE=configure.namespace
COMPANY_MAX_DAILY_TURNS=0
COMPANY_MAX_TASK_TURNS=8
COMPANY_MAX_DEPTH=3
# Resolve and record image digests at deployment qualification; these are starter tags.
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:16.15-bookworm

# Optional Claude Pro/Max subscription reviews; also enable Compose profile claude.
COMPANY_STAFF_REVIEW_ENABLED=false
STAFF_REVIEW_DAILY_LIMIT=2
CLAUDE_USAGE_CREDITS_DISABLED_CONFIRMED=false
CLAUDE_MEMORY_LIMIT=512m
