# Non-secret configuration only. Secret values live in STATE_DIR/secrets.
# Copy to deploy/.env on the host, then configure before starting services.
STATE_DIR=/var/lib/quant-company
RELEASE_COMMIT=REPLACE_WITH_40_CHARACTER_GIT_COMMIT
# Optional https profile only. Socket Mode needs no domain or public HTTP endpoint.
# COMPANY_DOMAIN=office.example.com
# ACME_EMAIL=owner@example.com
DATABASE_NAME=quant_company
SLACK_TEAM_ID=CONFIGURE
SLACK_ALLOWED_USERS=["U_REPLACE"]
SLACK_ALLOWED_CHANNELS=["C_REPLACE"]
# Owner commands are accepted only in the dedicated allowed channel with the director.
MODEL_ACCOUNTS_ENABLED=false
MODEL_ACCOUNTS_OWNER_USER=
MODEL_ACCOUNTS_CHANNEL_ID=
# Requires updated request producers, private runtime and account-control worker; see the model-assignments runbook.
MODEL_ASSIGNMENTS_ENABLED=false
TEMPORAL_ADDRESS=configure.tmprl.cloud:7233
TEMPORAL_NAMESPACE=configure.namespace
COMPANY_MAX_DAILY_TURNS=0
COMPANY_MAX_TASK_TURNS=8
COMPANY_MAX_DEPTH=3
# Reporter: collect continuously; preview model decisions before enabling Slack publication.
# Install the separate reporter Slack app and include its credentials/role before enabling.
COMPANY_NEWS_ENABLED=false
NEWS_PUBLISH_ENABLED=false
NEWS_CHANNEL_ID=
NEWS_OWNER_USER=
NEWS_MAX_AGE_HOURS=24
NEWS_INITIAL_LOOKBACK_MINUTES=120

# Zero-model RSS/Atom delivery through the existing Reporter identity.
TECH_FEED_ENABLED=false
TECH_FEED_PUBLISH_ENABLED=false
TECH_FEED_CHANNEL_ID=
TECH_FEED_OWNER_USER=

# Trend Scout: daily 08:00 KST; start in preview mode.
TREND_FEED_ENABLED=false
TREND_FEED_PUBLISH_ENABLED=false
TREND_FEED_CHANNEL_ID=
TREND_FEED_OWNER_USER=
TREND_FEED_PUBLICATION_HOURS=[8]
TREND_FEED_ON_DEMAND_ENABLED=false
TREND_FEED_MODEL_DAILY_LIMIT=2
# Enable with trend-feed.compose.yaml and its server-side secret only.
TREND_FEED_NAVER_ENABLED=false
HOUSING_FEED_ENABLED=false
HOUSING_FEED_PUBLISH_ENABLED=false
HOUSING_FEED_CHANNEL_ID=
HOUSING_FEED_OWNER_USER=
HOUSING_FEED_ALLOWED_CHANNELS=[]
# Resolve and record image digests at deployment qualification; these are starter tags.
CADDY_IMAGE=caddy:2-alpine
POSTGRES_IMAGE=postgres:16.15-bookworm

# Optional Claude Pro/Max subscription reviews; also enable Compose profile claude.
COMPANY_STAFF_REVIEW_ENABLED=false
STAFF_REVIEW_DAILY_LIMIT=2
CLAUDE_USAGE_CREDITS_DISABLED_CONFIRMED=false
CLAUDE_MEMORY_LIMIT=512m
QUANT_FEED_ENABLED=false
QUANT_FEED_PUBLISH_ENABLED=false
QUANT_FEED_CHANNEL_ID=
QUANT_FEED_OWNER_USER=
COMPANY_IMPROVEMENTS_ENABLED=false
DATA_WATCH_ENABLED=false
DATA_WATCH_PUBLISH_ENABLED=false
DATA_WATCH_CORE_ENABLED=false
DATA_WATCH_CHANNEL_ID=
DATA_WATCH_OWNER_USER=
IMPROVEMENTS_CHANNEL_ID=
