# Lightsail Linux $24 bundle: 2 vCPU, 4 GB, 80 GB disk, 20% CPU baseline (minimum for daily video).
# Hard limits below total 3,840 MiB with maintenance, Claude and the video worker. That is nearly the whole host:
# keep the 2 GiB swap file (docs/server-migration.md) and watch available memory during the first renders.
# The video worker peaks around 0.9 GiB while rendering and up to about 1.3 GiB during alignment (measured on a Mac,
# 2026-10-07); 1280m can still OOM during alignment, in which case the job stops as blocked and nothing is published.
POSTGRES_MEMORY_LIMIT=320m
POSTGRES_SHARED_BUFFERS=80MB
API_MEMORY_LIMIT=128m
SLACK_MEMORY_LIMIT=192m
WORKER_MEMORY_LIMIT=384m
DISPATCH_MEMORY_LIMIT=192m
CODEX_MEMORY_LIMIT=512m
CLAUDE_MEMORY_LIMIT=512m
MAINTENANCE_MEMORY_LIMIT=128m
# news-worker keeps its fixed 192m.
VIDEO_MEMORY_LIMIT=1280m
VIDEO_CPUS=1.5
VIDEO_RENDER_WORKERS=1
VIDEO_RETENTION_DAYS=14
VIDEO_MIN_FREE_GB=8
COMPANY_IMPROVEMENTS_ENABLED=false
IMPROVEMENTS_CHANNEL_ID=
