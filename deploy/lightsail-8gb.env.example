# Lightsail Linux $44 bundle: 2 vCPU, 8 GB, 160 GB disk, 30% CPU baseline (recommended for daily video).
# Hard limits below total 6,592 MiB with maintenance, Claude and the video worker, leaving about 1.5 GiB for the
# host, Docker and page cache. Add the 2 GiB swap file (docs/server-migration.md) as an OOM cushion, not capacity.
# Qualify on the new host: peak RSS/OOM during a full video render, restart, and the measured render time.
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_SHARED_BUFFERS=256MB
API_MEMORY_LIMIT=256m
SLACK_MEMORY_LIMIT=256m
WORKER_MEMORY_LIMIT=768m
DISPATCH_MEMORY_LIMIT=256m
CODEX_MEMORY_LIMIT=1g
CLAUDE_MEMORY_LIMIT=512m
MAINTENANCE_MEMORY_LIMIT=256m
# news-worker keeps its fixed 192m.
VIDEO_MEMORY_LIMIT=2048m
VIDEO_CPUS=1.5
VIDEO_RENDER_WORKERS=1
VIDEO_RETENTION_DAYS=14
VIDEO_MIN_FREE_GB=10
COMPANY_IMPROVEMENTS_ENABLED=false
IMPROVEMENTS_CHANNEL_ID=
