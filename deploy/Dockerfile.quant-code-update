# Quant-only immutable code overlay on a dependency-identical, reviewed base image.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG RELEASE_COMMIT
USER root
COPY src /opt/quant-code/src
USER 10001:10001
ENV PYTHONPATH=/opt/quant-code/src COMPANY_CODE_COMMIT=$RELEASE_COMMIT
LABEL org.opencontainers.image.revision=$RELEASE_COMMIT
