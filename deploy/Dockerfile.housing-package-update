ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG HOUSING_COMMIT
USER root
COPY src/quant_company/housing_feed/ /tmp/housing_feed/
RUN python -c "import importlib.util, pathlib, shutil; source=pathlib.Path('/tmp/housing_feed'); installed=pathlib.Path(importlib.util.find_spec('quant_company.housing_feed').origin).parent; tree=pathlib.Path('/opt/company/src/quant_company/housing_feed'); shutil.rmtree(installed); shutil.copytree(source, installed); shutil.rmtree(tree); shutil.copytree(source, tree); shutil.rmtree(source)"
USER 10001:10001
LABEL org.quant-company.housing-feed-revision=$HOUSING_COMMIT
