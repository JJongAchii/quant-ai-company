# Copy values into the existing private runtime.env after account and upstream qualification.
# Never replace existing briefing or release settings with this example.
VIDEO_ENABLED=false
# false (default): the finished MP4, thumbnail, SRT and upload.txt are posted into the brief's Slack thread and the
# owner uploads them. true: YouTube private upload (OAuth app in Testing mode keeps uploads private).
VIDEO_UPLOAD_ENABLED=false
VIDEO_PUBLISH_ENABLED=false
VIDEO_RUNWAY_WORKSPACE_ID=0
VIDEO_YOUTUBE_CHANNEL_ID=
VIDEO_MONTHLY_CREDIT_LIMIT=1500
VIDEO_EPISODE_CREDIT_LIMIT=100
# Script and review use the existing Claude subscription runtime (docs/claude-runtime.md).
VIDEO_MODEL=claude-opus-5-5
VIDEO_REASONING_EFFORT=xhigh
VIDEO_REVIEW_EFFORT=max
VIDEO_SPEECH_MODEL=eleven_v4
VIDEO_VOICE=Vincent
VIDEO_ALIGNMENT_MODEL=small
# Fixed card/motion template (docs/DAILY_BRIEF_DESIGN_SPEC.md). text-v1 keeps the earlier text slides.
VIDEO_TEMPLATE=motion-v2
# Frame-capture processes. 2 on the 8 GB host so the morning files land before 06:50 KST; 1 on smaller hosts.
VIDEO_RENDER_WORKERS=2
# 8 GB host (deploy/lightsail-8gb.env.example): 2048m / 2 CPU (the whole 2-vCPU host for the ~10 min render, when
# the brief has already been sent). Do not enable on the 2 GB host.
VIDEO_MEMORY_LIMIT=2048m
VIDEO_CPUS=2
# Rendering on ECS Fargate (docs/daily-video.md, deploy/render.json). local keeps rendering on this host.
VIDEO_RENDER_BACKEND=local
VIDEO_RENDER_REGION=ap-northeast-2
VIDEO_RENDER_BUCKET=
VIDEO_RENDER_CLUSTER=
VIDEO_RENDER_TASK_DEFINITION=
# JSON list of public subnet IDs, for example ["subnet-aaa","subnet-bbb"]
VIDEO_RENDER_SUBNETS=[]
VIDEO_RENDER_SECURITY_GROUP=
VIDEO_RENDER_ATTEMPTS=3
VIDEO_RENDER_TIMEOUT_MINUTES=90
VIDEO_RETENTION_DAYS=14
VIDEO_MIN_FREE_GB=10
# Performance analytics of the owner's public uploads (docs/daily-video.md "성과 분석"). Needs VIDEO_YOUTUBE_CHANNEL_ID,
# a dedicated channel listed in SLACK_ALLOWED_CHANNELS with the Analyst bot invited, and the YouTube login redone with
# the yt-analytics.readonly scope (OAuth app published to production, else tokens expire every 7 days).
VIDEO_ANALYTICS_ENABLED=false
VIDEO_ANALYTICS_CHANNEL_ID=
VIDEO_ANALYTICS_MAX_LESSONS=8
