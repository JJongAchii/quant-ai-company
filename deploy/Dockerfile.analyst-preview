# Operator-only locked dependency build on the verified installed image. Both the
# app and Codex bases retain their entrypoint, qdata source and native CLI binaries.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG RELEASE_COMMIT
USER root
WORKDIR /opt/company
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN UV_COMPILE_BYTECODE=0 uv sync --frozen --no-dev --no-editable --extra lake --reinstall-package quant-company
USER 10001:10001
ENV COMPANY_CODE_COMMIT=$RELEASE_COMMIT PYTHONPATH=/opt/company/src
LABEL org.opencontainers.image.revision=$RELEASE_COMMIT
