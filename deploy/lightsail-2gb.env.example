# Qualification candidate, not a measured production sizing claim.
# Append these values to the persistent runtime.env before the 2GB host trial.
# Socket Mode services total 1664 MiB, leaving 384 MiB of nominal 2 GiB for the host.
# Qualify Linux startup, Codex sandbox, peak RSS/OOM, and restart before adoption.
# Do not enable the optional HTTPS profile in this memory budget.
POSTGRES_MEMORY_LIMIT=256m
POSTGRES_SHARED_BUFFERS=64MB
API_MEMORY_LIMIT=128m
SLACK_MEMORY_LIMIT=192m
WORKER_MEMORY_LIMIT=256m
DISPATCH_MEMORY_LIMIT=192m
CODEX_MEMORY_LIMIT=640m
