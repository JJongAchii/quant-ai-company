{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPublishedCleanOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::insight-invest-datalake",
      "Condition": {"StringLike": {"s3:prefix": ["qdata/clean", "qdata/clean/", "qdata/clean/*"]}}
    },
    {
      "Sid": "ReadPublishedCleanOnly",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::insight-invest-datalake/qdata/clean/*"
    },
    {
      "Sid": "LocateExistingLake",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::insight-invest-datalake"
    }
  ]
}
