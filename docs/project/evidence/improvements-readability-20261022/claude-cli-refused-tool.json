    },
    {
     "type": "assistant/tool_use",
     "name": "StructuredOutput",
     "id": "toolu_01MtiRajt1xV6iHP3pC8YSMv"
    },
    {
     "type": "user/tool_result",
     "tool_use_id": "toolu_01MtiRajt1xV6iHP3pC8YSMv",
     "is_error": null,
     "content": "Structured output provided successfully"
    },
    {
     "type": "result",
     "subtype": "success",
     "is_error": false,
     "num_turns": 3,
     "permission_denials": [],
     "models": [
      "claude-haiku-5-5"
     ]
    }
   ]
  },
  {
   "max_turns": 1,
