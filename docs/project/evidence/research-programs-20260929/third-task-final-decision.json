4. \ub530\ub77c\uc11c \uc774\uc804\uc758 coverage=false\ub97c \ubc18\ubcf5\ud558\uc9c0 \uc54a\ub294\ub2e4. \uadf8\ub7ec\ub098 \uc6d0\ubcf8 S3 VersionId\uac00 \uace0\uc815\ub418\uc9c0 \uc54a\uc558\uace0 \ud604\uc7ac \uac1d\uccb4 \uc815\uccb4\uc131\uc774 \uc900\ube44 receipt\uc640 \ub2e4\ub974\uba70, adj_close 6,680\ud589\uc774 \ubd88\uc77c\uce58\ud55c\ub2e4. \uc885\ubaa9\ubcc4 \uc77c\uc815 \ubc30\uc728 \ubc0f \uc5d4\uc9c4 \uc7ac\uae30\uc900\ud654\uc640 \ubd80\ud569\ud55c\ub2e4\ub294 \uc124\uba85\uc740 \uc6d0\ubcf8 \uc0dd\uc131\u00b7\ubcc0\ud658 \uc774\ub825\uc774\ub098 \uc6d0\ucc9c \uacf5\ud45c\uc2dc\uac01\uc744 \uc778\uc99d\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud30c\uc77c \ud574\uc2dc\uc640 available_at \ud544\ub4dc\ub3c4 \uacfc\uac70 \uc2e4\uc81c \uc774\uc6a9\uac00\ub2a5\uc2dc\uac01\uc758 \ub3c5\ub9bd \uc99d\uac70\ub97c \ub300\uc2e0\ud558\uc9c0 \ubabb\ud55c\ub2e4. \ud3c9\uac00\uc5d0 \ub0a8\uc544 \uc788\ub294 \ub9c8\uc9c0\ub9c9 \uc138\uc158\uc758 \ub2e4\uc74c \ub0a0 08:30 \ubbf8\uac80\uc99d \ud56d\ubaa9\uc740 \ud604\uc7ac\uc758 09:00 \uacc4\uc57d\uacfc \uad6c\ubcc4\ud558\uace0, \uc2e4\uc81c \uc2e0\ud638\uc5d0 \uc0ac\uc6a9\ub418\ub294 \ud589\uc744 \uae30\uc900\uc73c\ub85c \ub2e4\uc2dc \ud310\ub2e8\ud574\uc57c \ud55c\ub2e4. 104\uc138\uc158\uc774\ub77c\ub294 \ubc94\uc704\ub294 \ud544\uc694\ud55c \ucd5c\uc18c 81\uac1c \uac00\uaca9 \uad00\uce21\ubcf4\ub2e4 \uae38\uc9c0\ub9cc, \ucd5c\ucd08 \uc758\uc0ac\uacb0\uc815 \uc2dc\uc810\uc5d0 \uc774\uc6a9 \uac00\ub2a5\ud55c \uc5f0\uc18d \uc720\ud6a8 \uac00\uaca9\uacfc \uc644\uc131 \ud2b9\uc9d5 60\uac1c\u00b7\ud3c9\uac00 \ud2b9\uc9d5 1\uac1c, \uc218\uce58 \uc720\ud6a8\uc131\uacfc \uc801\ud569 \uac00\ub2a5\uc131\uae4c\uc9c0 \uc778\uc99d\ud558\uc9c0\ub294 \uc54a\ub294\ub2e4. \uc7ac\uac80\ud1a0\uc5d0\ub294 \uc2b9\uc778\ub41c \uc785\ub825\u00b7\ud504\ub85c\ud544\uc744 \uc720\uc9c0\ud55c \uc6d0\ucc9c \ubc0f \ubcc0\ud658 \uc774\ub825, \uc2e4\uc81c \uc0ac\uc6a9 \uc774\ub825\uc758 09:00 \uc774\uc804 \uc774\uc6a9\uac00\ub2a5\uc131, \ucd5c\ucd08 \ud2b9\uc9d5 \uad6c\uc131, \ud574\ub2f9 \uc885\ubaa9\uc758 \ud604\uc7ac\u00b7\ub2e4\uc74c \uac00\uaca9\uacfc \uac70\ub798\uac00\ub2a5\uc131 \uac80\uc0ac, \ud658\uacbd \uc758\uc874\uc131\uacfc \uacc4\uc0b0\uc2dc\uac04 \uadfc\uac70\uac00 \ud544\uc694\ud558\ub2e4. \uc2e4\uc81c \ud638\uac00 \uccb4\uacb0\uacfc \ud604\uae08\ubc30\ub2f9 \ucd1d\uc218\uc775\uc740 \ud604\uc7ac \uc5f0\uad6c\uac00 \uc785\uc99d\ud560 \ubc94\uc704 \ubc16\uc774\ub2e4. \uc774\ub97c \uad6c\ud604\ud558\ub824\uace0 \ubcf4\ud638 \uc5d4\uc9c4\uc744 \ubcc0\uacbd\ud558\uac70\ub098 \uc2e4\uac70\ub798 \ubcf4\uc7a5\uc744 \ucd94\uac00 \uc694\uad6c\ud558\uc9c0 \uc54a\ub418, \uc774\ub860\uc801 \uc870\uc815\uc2dc\uac00 \ud3c9\uac00\uc5d0 \ud544\uc694\ud55c \uc6d0\ucc9c\u00b7\uc2dc\uc810\uc131 \uac80\uc99d\uc740 \uc0dd\ub7b5\ud558\uc9c0 \uc54a\ub294\ub2e4. \uace0\uc815 069500 \uc124\uacc4\uc5d0\ub294 \ud3d0\uae30\ub41c \uac70\ub798\ub300\uae08 \uc21c\uc704 \uc120\uc815\uc774\ub098 \uc804\uccb4 \uacfc\uac70 ETF \ubaa8\uc9d1\ub2e8 \uac80\uc99d, 252\uac1c \ud559\uc2b5 \ud2b9\uc9d5 \uc694\uac74\uc744 \ub2e4\uc2dc \uc694\uad6c\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc6d0\ubb38 PDF p.2~3\u00b76~7\uc758 17\uc694\uc778 \uacf5\ub3d9\ubd84\ud3ec \ubd84\uc11d, \uad50\ucc28\uac80\uc99d \uad70\uc9d1 \uc120\ud0dd, \ube44\uc608\uce21\uc131\uacfc \uae09\uaca9\ud55c \uc0c1\ud0dc \uc804\ud658\uc5d0 \ube44\ucdb0 \ubcf8\uc548\uc758 \ub2e8\uc77c ETF\u00b7\ub450 \ud2b9\uc9d5\u00b7\uace0\uc815 2\uc131\ubd84\u00b760\uac1c \ud2b9\uc9d5 \uc21c\ucc28 \ud559\uc2b5\u00b7\ubbf8\ub798 \ube44\uc6a9 \ud6c4 \uc131\uacfc\ub294 novel_hypothesis\ub85c \ubd84\ub958\ud558\ub294 \uac83\uc774 \uc801\uc808\ud558\ub2e4. \uc704\ud5d8 \uc0c1\ud0dc\uc758 \uc9c0\uc18d\uc131\uc774 \ub2e4\uc74c \ubcf4\uc720\uae30\uac04\uc5d0 \uc720\uc6a9\ud558\ub2e4\ub294 \uc5f0\uacb0\uc740 \uc0c8 \uac80\uc99d \ub300\uc0c1\uc774\uba70 \uc6d0\ubb38\uc774 \uc218\uc775\uc131\uc744 \ubcf4\uc99d\ud558\uc9c0 \uc54a\ub294\ub2e4. \uae30\uc874 \ub450 \ub300\uae30 \uacfc\uc81c\uc640\ub294 \uba85\uc138\uac00 \ub2ec\ub77c\uc84c\uc9c0\ub9cc \uac19\uc740 \ud6c4\ubcf4\uad70\uc758 \ubcf4\uc644\uc548\uc774\uace0 \uc138 \uacfc\uc81c \ubaa8\ub450 \uc2e4\ud589 \ubbf8\uc158\uc774 \uc5c6\ub2e4. \ubcc4\ub3c4\uc758 \uc131\uacf5\u00b7\uc2e4\ud328 \uc2e4\ud5d8\uc73c\ub85c \uc138\uac70\ub098 \uc911\ubcf5 \uc2dc\ud589\uc744 \ubc30\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud5c8\uc6a9 \uc120\ud589 \ubbf8\uc158\uc774 \uc5c6\uc73c\ubbc0\ub85c predecessor_mission_ids=[]\ub97c \uc720\uc9c0\ud55c\ub2e4. \uba85\uc138\uc0c1 etf_strategy\uc758 \uc9c0\uc815 \uc785\ub825\u00b7\ucf54\ub4dc \ubcc0\uacbd \ubc94\uc704\u00b7\uc2e4\ud589 \ud504\ub85c\ud544, 2023-01-02~2025-12-30 \uac1c\ubc1c\uae30\uac04, stress-net-absolute-cagr \ubaa9\uc801, \uace0\uc815 \uc6d4 \ub2e8\uc704 \ud3c9\uac00\uc640 \ucd1d\ub178\ucd9c 1.0 \uc81c\ud55c\uc740 \uc720\uc9c0\ub41c\ub2e4. \ud604\uc7ac \uae30\ub85d\uc740 \uc2dc\ud589\u00b7\ubbf8\uacb0 \uc2dc\ud589\u00b7\ubbf8\uc158\u00b7\uacc4\uc0b0\uc2dc\uac04 \ubaa8\ub450 0\uc774\ubbc0\ub85c \uc794\uc5ec \ud55c\ub3c4\ub294 24\ud68c\u00b76\ubbf8\uc158\u00b736,000\ucd08\uc774\uba70 \ub3d9\uc2dc \ubbf8\uc158\uc740 1\uac1c\ub2e4. \ud6c4\ubcf4\uc640 \uc138 \ub300\uc870\uad70\uc758 \ucd5c\ub300 4\ud68c\u00b71\ubbf8\uc158 \uacc4\ud68d\uc740 \ud69f\uc218 \ud55c\ub3c4 \uc548\uc774\uc9c0\ub9cc \ud658\uacbd\uacfc \uc2dc\uac04 \ub0b4 \uc2e4\ud589 \uac00\ub2a5\uc131\uc740 \ubbf8\uac80\uc99d\uc774\ub2e4. \uc11c\ube44\uc2a4\uc758 \uc8fc\uae30\ubcc4 \ud55c\ub3c4\uc640 \uc911\ub2e8 \uaddc\uce59\uc744 \uc6b0\uc120\ud558\uace0 \ubbf8\uc2e4\ud589 \ub300\uc870\uad70\uc740 \ubbf8\uce21\uc815\uc73c\ub85c \ub0a8\uaca8\uc57c \ud55c\ub2e4. P11 \ubcf4\uace0\uc11c\ub294 \ucd94\uac00 \uacfc\ud559 \uc2dc\ud589 0\ud68c\uc758 equivalent_replay\uc640 \uae30\uc874 \uac10\uc0ac \uc7ac\uc0ac\uc6a9\uc744 \uae30\ub85d\ud558\uba70 \uae30\uc900\uc120\u00b7\ucd08\uacfc\uc131\uacfc\ub294 \ubbf8\uce21\uc815\uc774\ub2e4. \uc774\ub97c \ud604\uc7ac \ud6c4\ubcf4\uc758 \uc2e4\ud589\u00b7\uc2e4\ud328\u00b7\uc900\ube44\uc131 \uc99d\uac70\ub85c \uc804\uc6a9\ud558\uc9c0 \uc54a\uace0 \uacfc\uac70 \ud0d0\uc0c9 3\ud68c\ub97c \ud604 \ud504\ub85c\uadf8\ub7a8 \uc0ac\uc6a9\ub7c9\uc5d0 \ud569\uc0b0\ud558\uc9c0 \uc54a\ub294\ub2e4. \uac10\uc0ac \uc6d0\ubb38\uacfc \uc6d0\uc2dc \uc131\uacfc\uc758 \uc0c8 \uac80\uc99d\ub3c4 \uc8fc\uc7a5\ud558\uc9c0 \uc54a\ub294\ub2e4. P11 \uc9d1\uacc4\uae30\uac04\uc740 \ud604 \ubd09\uc778\uae30\uac04\uacfc \uacb9\uce58\ubbc0\ub85c \uadf8 \uc9d1\uacc4\ub85c \ud6c4\ubcf4\ub97c \uc120\ud0dd\ud558\uac70\ub098 \ubd09\uc778\uc744 \uc644\uc804\ud788 \ubbf8\ub178\ucd9c\ub41c \ud655\uc99d \ud45c\ubcf8\uc774\ub77c\uace0 \ubd80\ub97c \uc218 \uc5c6\ub2e4. \ucc28\ub2e8 \uc0ac\uc720\uc5d0 \ub300\ud55c \ub3c5\ub9bd \uc7ac\ud3c9\uac00\uc640 \uae30\uc220\u00b7\uc790\uc6d0 \uadfc\uac70\uac00 \ud655\ubcf4\ub418\uba74 \ud604\uc7ac\uc548\uc744 \uc7ac\uac80\ud1a0\ud560 \uc218 \uc788\ub2e4. \uc774\ubc88 \ubcf4\ub958\ub294 \uacfc\ud559\uc801 \ubc18\uc99d\uc774 \uc544\ub2c8\ub2e4. \uc774\ud6c4 \uacc4\uc57d\uc744 \ucda9\uc871\ud558\uace0 \uc720\ud6a8 \uc6d4\uc774 30\uac1c \uc774\uc0c1\uc778 \ud3c9\uac00\uc5d0\uc11c \uc2a4\ud2b8\ub808\uc2a4 \uc21c CAGR\uc774 0 \uc774\ud558\ub77c\uba74 \uc720\uc6a9\ud55c \uc74c\uc758 \uc5f0\uad6c \uacb0\uacfc\ub85c \ubcf4\uc874\ud55c\ub2e4. \uc591\uc218\uc5ec\ub3c4 \uace0\uc815 \ud3c9\uac00\uae30\uc758 95% \ubd88\ud655\uc2e4\uc131 \ubc94\uc704\uac00 0\uc744 \ud3ec\ud568\ud558\uba74 \uc591\uc758 \ud6a8\uacfc \uc785\uc99d\uc744 \uc8fc\uc7a5\ud558\uc9c0 \uc54a\uc73c\uba70, \ub300\uc870\uad70 \uadfc\uac70 \uc5c6\uc774 GMM\uc758 \ucd94\uac00 \uac00\uce58\ub97c \uc8fc\uc7a5\ud558\uc9c0 \uc54a\ub294\ub2e4. \uae30\uc220 \uc911\ub2e8\uc744 \uc218\uc775\ub960 0\uc774\ub098 \uc190\uc2e4 \ubc18\uc99d\uc73c\ub85c \uacc4\uc0c1\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc774 \uc0b0\ucd9c\ubb3c\uc740 \uc120\ud0dd \uac80\ud1a0\uc758 \uc644\ub8cc\uc774\uba70 \uc2b9\uc778\u00b7Git \ubcc0\uacbd\u00b7\uc5f0\uad6c \uc2e4\ud589\u00b7\uac8c\uc2dc\uc758 \uc644\ub8cc \ubcf4\uace0\uac00 \uc544\ub2c8\ub2e4."}, "id": "875a7d41-e6e5-5a67-94cf-8b7d9d8c2d00", "proposal_digest": "d410c8987e3c31879850a8cd746bb31ddf24634ec534a9de825d70eb28a3168b", "state": "waiting"}}
