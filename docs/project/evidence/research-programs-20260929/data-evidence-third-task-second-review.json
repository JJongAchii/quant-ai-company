4 weights(history, config)\uc5d0\uc11c 069500\uc758 \ube44\uc74c\uc218 \ubaa9\ud45c \ube44\uc911 \ud558\ub098\ub97c \ubc18\ud658\ud55c\ub2e4. \uc5d4\uc9c4\uc758 \uc774\ub860\uc801 \uc2dc\uac00 \uc7ac\uc870\uc815 \uc2dc\uc810\uc5d0 \uc774\uc6a9 \uac00\ub2a5\ud55c \uacfc\uac70 \uc785\ub825\uc73c\ub85c \ubaa9\ud45c\ub97c \uc815\ud558\ub294 \uacc4\uc57d\uc774\uba70 \ubcc4\ub3c4 08:30 \uc758\uc0ac\uacb0\uc815\uc774\ub098 \uc885\uac00 \uccb4\uacb0\uc744 \uac00\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.\n(4) t\ub294 \uc81c\uacf5\ub41c 069500 \uc774\ub825\uc758 \ucd5c\uc2e0 \ub0a0\uc9dc\ub2e4. r_t=adj_close_t/adj_close_(t-1)-1, s20_t\ub294 t\uae4c\uc9c0 \ucd5c\uadfc 20\uac1c \uc77c\uc218\uc775\ub960\uc758 \ud45c\ubcf8 \ud45c\uc900\ud3b8\ucc28(ddof=1), x_t=(r_t, log(max(s20_t,1e-8)))\ub85c \uc815\uc758\ud55c\ub2e4. t\ubcf4\ub2e4 \uc55e\uc120 \ucd5c\uadfc 60\uac1c \uc644\uc131 \ud2b9\uc9d5\uc5d0\ub9cc \ud3c9\uade0\u00b7\ud45c\uc900\ud3b8\ucc28(ddof=1)\ub97c \uc801\ud569\ud558\uace0 \uc815\uaddc\ud654\ud558\uc5ec 2\uc131\ubd84 full-covariance GMM\uc744 \ub9e4 \uac70\ub798\uc77c \uc0c8\ub85c \uc801\ud569\ud55c\ub2e4. reg_covar=1e-6, random_state=0, n_init=1, max_iter=200, tol=1e-3\uc744 \uace0\uc815\ud55c\ub2e4. \ud559\uc2b5 \ud2b9\uc9d5 60\uac1c\uc640 \ud3c9\uac00 \ud2b9\uc9d5 1\uac1c\ub97c \uc704\ud574 \ucd5c\ucd08 \uc2e0\ud638\uae4c\uc9c0 \ucd5c\uc18c 81\uac1c\uc758 \uc5f0\uc18d\ub41c \uc720\ud6a8 \uac00\uaca9 \uad00\uce21\uc774 \ud544\uc694\ud558\ub2e4. \ucd5c\ucd08 warmup\uc5d0\uc11c \uc774 \uc694\uac74\uc744 \ud655\uc778\ud558\uc9c0 \ubabb\ud558\uba74 \ud604\uae08 \uc218\uc775\uc73c\ub85c \ud559\uc2b5 \ubd80\uc871\uc744 \uc228\uae30\uc9c0 \uc54a\uace0 \uae30\uc220 \uc911\ub2e8\ud55c\ub2e4. \ucd5c\ucd08 \uc774\ub825 \ucda9\uc871\uc740 \ud604\uc7ac \ud655\ubcf4\ub41c \uc785\ub825 \uc77c\ubd80\ub9cc\uc73c\ub85c \uc778\uc99d\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc815\uaddc\ud654 \ubd84\uc0b0 0, \ube44\uc720\ud55c \uc218\uce58, \ube44\uc218\ub834 \ub610\ub294 \ud544\uc694\ud55c \uad00\uce21 \ub204\ub77d\ub3c4 \uae30\uc220 \uc911\ub2e8\uc774\ub2e4. \uc6d0\ub2e8\uc704 \uc77c\uc218\uc775\ub960 \ubd84\uc0b0\uc774 \ud070 \uc131\ubd84\uc744 \uace0\uc704\ud5d8\uc73c\ub85c \uc815\ud558\uace0 \ub3d9\ub960\uc774\uba74 \ud3c9\uade0 \uc218\uc775\ub960\uc774 \ub0ae\uc740 \uc131\ubd84, \ub2e4\uc2dc \ub3d9\ub960\uc774\uba74 \uc131\ubd84 \uc778\ub371\uc2a4\ub97c \uc0ac\uc6a9\ud55c\ub2e4. \ud559\uc2b5\uc5d0\uc11c \uc81c\uc678\ud55c x_t\uc758 \uace0\uc704\ud5d8 \ud655\ub960 q_t\ub85c w=1-0.5*q_t\ub97c \uacc4\uc0b0\ud55c\ub2e4. \ubbf8\ub798 \ubcf4\uc720\uc218\uc775\uc740 \uc0c1\ud0dc \uc774\ub984\u00b7\uc815\uaddc\ud654\u00b7\ud559\uc2b5\uc5d0 \uc4f0\uc9c0 \uc54a\ub294\ub2e4. \uc804\ubc29 \ub77c\ubca8\uc744 \ud559\uc2b5\uc9d1\ud569\uc5d0 \ub123\uc9c0 \uc54a\uc73c\ubbc0\ub85c \ud3c9\uac00 \uad6c\uac04\uacfc \uc885\ub8cc\uac00 \uacb9\uce58\ub294 \ud559\uc2b5 \ub77c\ubca8\ub3c4 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \ub9e4\uc77c \uacfc\uac70 \uc790\ub8cc\ub9cc\uc73c\ub85c \uc21c\ucc28 \uc801\ud569\ud558\uba70 \uc804\uae30\uac04 \uc801\ud569\uc774\ub098 \ubb34\uc791\uc704 \ubd84\ud560\uc740 \ud558\uc9c0 \uc54a\ub294\ub2e4.\n(5) \uccb4\uacb0\uacfc \uc190\uc775\uc740 \ubcf4\ud638 \uc5d4\uc9c4 \uadf8\ub300\ub85c\ub2e4. A_d=open_d*adj_close_d/close_d, R_d=A_next/A_d-1\uc744 \uc0ac\uc6a9\ud558\uc5ec d \uc2dc\uac00\ubd80\ud130 \uc785\ub825\uc758 \ub2e4\uc74c \uad00\uce21 \uac70\ub798\uc77c \uc2dc\uac00\uae4c\uc9c0 \ud3c9\uac00\ud55c\ub2e4. \ud6c4\ubcf4\ub294 \ud574\ub2f9 \uc2dc\uac00\ub098 \ub2e4\uc74c \uc2dc\uac00\ub97c \uc8fc\ubb38 \uacb0\uc815 \uc785\ub825\uc73c\ub85c \ubc1b\uc9c0 \uc54a\ub294\ub2e4. \uc5d4\uc9c4\uc740 \uc8fc\uc2dd \uc218 \uc8fc\ubb38\uc774\ub098 \ud638\uac00 \uccb4\uacb0 \ub300\uc2e0 \ubaa9\ud45c \ube44\uc911\uc744 \uc9c1\uc811 \uc801\uc6a9\ud55c\ub2e4. \ub530\ub77c\uc11c \uc774 \uacb0\uacfc\ub97c \uc2e4\uc81c \uc2dc\uac00 \uccb4\uacb0 \ubcf4\uc7a5\uc73c\ub85c \ud45c\ud604\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub9e4 \uac70\ub798\uc77c \ubaa9\ud45c\ub85c \uc7a