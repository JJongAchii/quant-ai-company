{
  "display_information": {
    "name": "Trend Scout",
    "description": "정기 검색 트렌드 브리핑과 전용 채널의 실시간 검색어 요청 응답"
  },
  "features": {
    "bot_user": {
      "display_name": "trend-scout",
      "always_online": false
    }
  },
  "oauth_config": {"scopes": {"bot": ["chat:write", "app_mentions:read", "channels:history"]}},
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "event_subscriptions": {
      "bot_events": ["app_mention", "message.channels"]
    }
  }
}
